# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Unleashed: Integration -> Unleashed API Access
UNLEASHED_API_ID=
UNLEASHED_API_KEY=
# live = real Unleashed API; mock = built-in simulated data.
# If left out: live when the ID and key above are set, otherwise mock.
UNLEASHED_MODE=live
# UNLEASHED_BASE_URL=https://api.unleashedsoftware.com
# UNLEASHED_CACHE_SECONDS=120
# Local copy of Unleashed data: how often it updates and how far back it goes.
# SYNC_INTERVAL_MINUTES=15
# SYNC_HISTORY_MONTHS=13

# Shared database so others can use the same data (see README, "Sharing with others").
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Team accounts: your email and a temporary password for the first admin account.
# You choose your own password at first sign-in, then add your team on the Team page.
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
# Business time zone for "today" and month boundaries (needed when hosted on a UTC server).
# TIMEZONE=America/Los_Angeles
