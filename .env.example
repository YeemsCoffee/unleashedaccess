# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Unleashed: Integration -> Unleashed API Access
UNLEASHED_API_ID=
UNLEASHED_API_KEY=
# mock = built-in simulated Unleashed (default); live = real Unleashed API
UNLEASHED_MODE=mock
